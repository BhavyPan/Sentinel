# Supabase transaction pooler (runtime/serverless). Add pgbouncer=true for Prisma.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Supabase session pooler or direct connection (Prisma schema operations).
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
# Optional OpenAI-compatible provider. Groq is the recommended free-tier option.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
AI_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b
# Put the real key in .env.local. Never use NEXT_PUBLIC_ for this key.
AI_API_KEY=
# Change to auto only after adding a provider key.
AI_MODE=local
